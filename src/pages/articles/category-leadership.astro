---
import sourceBody from '../../content/source-body.html?raw';
import { applySiteCopy } from '../../content/site-copy.mjs';
import '../../styles/directional-navigation.css';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const homeUrl = base;
const contactUrl = `${base}contact-us/`;
const copiedBody = applySiteCopy(sourceBody);

const navStartMarker = '<div data-animation="default" class="navbar-new w-nav"';
const navStart = copiedBody.indexOf(navStartMarker);
const navEnd = copiedBody.indexOf('<div class="page-wrapper">', navStart);
const footerStart = copiedBody.indexOf('<section class="section footer-new">');
const pageWrapperEnd = copiedBody.lastIndexOf('</div>');

if (navStart < 0 || navEnd < 0 || footerStart < 0 || pageWrapperEnd < 0) {
  throw new Error('Unable to extract the shared article-page shell.');
}

const navigationLogoPattern =
  /(<a[^>]*class="brand-new-inner w-inline-block"[^>]*>)<svg[\s\S]*?<\/svg>(<\/a>)/;
const footerLogoPattern =
  /(<a[^>]*class="footer-link-logo w-inline-block"[^>]*>)<svg[\s\S]*?<\/svg>(<\/a>)/;
const navigationLogo = `<img src="${base}assets/itk-logo.svg" alt="" class="contain-image nav-brand-logo" width="160" height="20" />`;
const footerLogo = `<img src="${base}assets/itk-logo.svg" alt="" class="contain-image footer-brand-logo" width="160" height="20" style="display:block;width:100%;height:auto;aspect-ratio:8 / 1" />`;

let navigation = copiedBody.slice(navStart, navEnd);
const sharedGlobalEmbeds = copiedBody.slice(0, navStart);
navigation = navigation
  .replace('class="navbar-new w-nav"', 'class="navbar-new is-away-from-hero w-nav"')
  .replace(navigationLogoPattern, `$1${navigationLogo}$2`)
  .replace('href="./" class="brand-new-inner', `href="${homeUrl}" class="brand-new-inner`)
  .replace('href="#" class="nav-link-new', `href="${homeUrl}#how-it-works" class="nav-link-new`)
  .replace('href="#clients" class="nav-link-new', `href="${homeUrl}#clients" class="nav-link-new`)
  .replace('href="#faqs" class="nav-link-new', `href="${homeUrl}#faqs" class="nav-link-new`)
  .replace('href="https://in-the-kitchen.webflow.io/contact-us"', `href="${contactUrl}"`);

const rawFooter = copiedBody
  .slice(footerStart, pageWrapperEnd)
  .replace('href="./" class="footer-link-logo', `href="${homeUrl}" class="footer-link-logo`);

if (!footerLogoPattern.test(rawFooter)) {
  throw new Error('Unable to locate the shared footer logo.');
}

const footer = rawFooter.replace(footerLogoPattern, `$1${footerLogo}$2`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Category leadership comes from compounding advantages and the integrity of the decisions beneath your positioning."
    />
    <title>How category leaders win | In The Kitchen</title>
    <link rel="stylesheet" href={`${base}styles/webflow.css`} />
    <link rel="icon" href={`${base}assets/favicon-small.png`} />
  </head>
  <body class="body-new category-article-page">
    <Fragment set:html={sharedGlobalEmbeds} />
    <div class="page-wrapper">
      <Fragment set:html={navigation} />

      <main class="category-article-main">
        <section class="category-article-hero" aria-labelledby="category-article-heading">
          <article class="category-article-card">
            <header class="category-article-header">
              <h1 id="category-article-heading">
                <span>You don’t create category</span>
                <span>leadership by being a little bit better.</span>
                <span class="category-article-heading-break">You do it by being</span>
                <span>fundamentally different.</span>
              </h1>
              <div class="category-article-meta" aria-label="Article details">
                <div class="category-article-reading-meta">
                  <span>4 min read</span>
                  <button class="category-article-listen" type="button" aria-pressed="false">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M4 14v-2a8 8 0 0 1 16 0v2" />
                      <path d="M4 14h2v5H4a2 2 0 0 1-2-2v-1a2 2 0 0 1 2-2Z" />
                      <path d="M20 14h-2v5h2a2 2 0 0 0 2-2v-1a2 2 0 0 0-2-2Z" />
                    </svg>
                    <span class="category-article-listen-label">Listen</span>
                  </button>
                </div>
                <div class="category-article-author">
                  <span class="category-article-author-portrait" aria-hidden="true">
                    <img src={`${base}assets/jon-itkin-byline.png`} alt="" width="40" height="40" />
                  </span>
                  <span>By Jon Itkin</span>
                </div>
              </div>
            </header>

            <div class="category-article-rule" aria-hidden="true"></div>

            <div class="category-article-copy">
              <p>People will tell you positioning is a game of inches. Category leaders disagree. They drive compounding advantages across four dimensions, and product capabilities are only one.</p>
              <p>We use the Four Cs heuristic to deeply understand why you win. Then we channel our learnings into positioning and messaging that hits the market like a pile driver.</p>
              <h2>The four sources of competitive advantage:</h2>
            </div>

            <div class="category-article-four-cs">
              <section>
                <h3>Capability</h3>
                <p>What your buyers can do (and not do) as a result of your product.</p>
              </section>
              <section>
                <h3>Credibility</h3>
                <p>What makes you exceptionally trustworthy.</p>
              </section>
              <section>
                <h3>Convenience</h3>
                <p>Why it’s easier to buy from you.</p>
              </section>
              <section>
                <h3>Cost</h3>
                <p>Why you deliver outstanding value relative to investment.</p>
              </section>
            </div>
          </article>
        </section>

        <section class="category-article-quote" aria-label="Client testimonial">
          <figure>
            <blockquote>
              <p>“Jon helped us execute a crucial strategic repositioning and build a message that we fully own. Within weeks of launching, we closed our first enterprise deal and built a deep pipeline. The ideas and language we co-created are pulling the company forward.”</p>
            </blockquote>
            <figcaption>Alex Gallego, CEO, Redpanda</figcaption>
          </figure>
        </section>

        <section class="category-article-decisions" aria-labelledby="category-decisions-heading">
          <article class="category-article-card category-decisions-card">
            <div class="category-decisions-headlines">
              <h2 id="category-decisions-heading">
                <span>Marketing copy doesn’t</span>
                <span>make you a category leader.</span>
              </h2>
              <h2>Decisions do.</h2>
            </div>
            <div class="category-article-rule" aria-hidden="true"></div>
            <div class="category-article-copy">
              <p>After more than 45 deep-dive positioning exercises, we’ve learned that the most important factor behind positioning success is the integrity of the decisions beneath it.</p>
              <p>So we developed Decision-Based Positioning: a methodology that treats decisions as a first-class deliverable of the positioning process.</p>
              <p>With us, executives spend time debating crucial decisions, not splitting hairs over headlines. You leave with conviction about the path you’re taking, not just what you will say.</p>
              <h2>Decisions to win:</h2>
            </div>
            <ul class="category-decisions-list">
              <li><span>Intentions</span><span>7 decisions</span></li>
              <li><span>Playing Field</span><span>4 decisions</span></li>
              <li><span>Market Segment</span><span>3 decisions</span></li>
              <li><span>Buyer</span><span>4 decisions</span></li>
              <li><span>Problem</span><span>3 decisions</span></li>
              <li><span>Alternatives</span><span>3 decisions</span></li>
              <li><span>Advantages</span><span>5 decisions</span></li>
              <li><span>How You Win</span><span>2 decisions</span></li>
            </ul>
          </article>
        </section>
      </main>

      <Fragment set:html={footer} />
    </div>

    <script is:inline>
      (() => {
        const menuButton = document.querySelector('.menu-button-new');
        const navigation = document.querySelector('.navigation-new');

        if (menuButton && navigation) {
          menuButton.setAttribute('role', 'button');
          menuButton.setAttribute('tabindex', '0');
          menuButton.setAttribute('aria-label', 'menu');
          menuButton.setAttribute('aria-expanded', 'false');

          const setMenu = (open) => {
            const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
            menuButton.classList.toggle('w--open', open);
            navigation.classList.toggle('w--open', open);
            navigation.style.transition = open ? 'all, transform 400ms' : '';
            navigation.style.transform = open ? 'translateY(0px)' : '';
            document.documentElement.style.overflow = open ? 'hidden' : '';
            document.documentElement.style.boxSizing = open ? 'border-box' : '';
            document.documentElement.style.paddingRight = open ? `${scrollbarWidth}px` : '';
            menuButton.setAttribute('aria-expanded', String(open));
          };

          const toggleMenu = () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true');
          menuButton.addEventListener('click', toggleMenu);
          menuButton.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              toggleMenu();
            }
          });
          navigation.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', () => setMenu(false));
          });
          window.addEventListener('resize', () => {
            if (window.innerWidth > 991) setMenu(false);
          });
        }

        const listenButton = document.querySelector('.category-article-listen');

        if (listenButton && 'speechSynthesis' in window && 'SpeechSynthesisUtterance' in window) {
          const listenLabel = listenButton.querySelector('.category-article-listen-label');
          const article = document.querySelector('.category-article-main');
          let activeUtterance = null;

          const resetListenButton = () => {
            activeUtterance = null;
            listenButton.setAttribute('aria-pressed', 'false');
            if (listenLabel) listenLabel.textContent = 'Listen';
          };

          listenButton.addEventListener('click', () => {
            if (activeUtterance) {
              window.speechSynthesis.cancel();
              resetListenButton();
              return;
            }

            const articleText = article?.innerText.trim() ?? '';
            if (!articleText) return;

            activeUtterance = new window.SpeechSynthesisUtterance(articleText);
            activeUtterance.rate = 0.95;
            activeUtterance.onend = resetListenButton;
            activeUtterance.onerror = resetListenButton;
            listenButton.setAttribute('aria-pressed', 'true');
            if (listenLabel) listenLabel.textContent = 'Stop';
            window.speechSynthesis.speak(activeUtterance);
          });

          window.addEventListener('pagehide', () => {
            if (activeUtterance) window.speechSynthesis.cancel();
          });
        } else if (listenButton) {
          listenButton.hidden = true;
        }

        document.querySelectorAll('.copyright-year').forEach((year) => {
          year.textContent = String(new Date().getFullYear());
        });
      })();
    </script>
    <script>
      import { initDirectionalNavigation } from '../../scripts/directional-navigation.js';

      initDirectionalNavigation();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --article-canvas: #fdfcfa;
    --article-paper: #fff;
    --article-lavender: #e1dbfc;
    --article-ink: #222;
    --article-deep-ink: #1a1a1a;
    --article-hairline: #e3e3e3;
    --hero-folder-gutter: clamp(1rem, 1.8vw, 2rem);
    --hero-tab-width: clamp(14rem, 20.6vw, 22rem);
    --hero-tab-half-width: clamp(7rem, 10.3vw, 11rem);
    --hero-tab-height: clamp(2.94rem, 4.327vw, 4.625rem);
    --hero-tab-top: clamp(1.5rem, 2.75vw, 2.5rem);
    --hero-tab-offset: clamp(0.625rem, 0.85vw, 0.875rem);
    --hero-nav-top: clamp(1.25rem, 1.6vw, 1.5rem);
    --nav-away-inline-shift: calc(
      -1 * (var(--hero-tab-offset) + var(--hero-tab-half-width) - 5.7rem)
    );
  }

  html {
    scroll-behavior: smooth;
  }

  .category-article-page,
  .category-article-page .page-wrapper {
    color: var(--article-ink);
    background: var(--article-canvas);
  }

  .category-article-page a:focus-visible,
  .category-article-page button:focus-visible,
  .category-article-page .menu-button-new:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .category-article-page .navbar-new {
    padding-top: var(--hero-nav-top);
  }

  .category-article-page .nav-bg-main {
    opacity: 1;
    background: var(--article-canvas);
  }

  .category-article-page .navbar-new .nav-container-new {
    max-width: none;
    padding-right: var(--hero-folder-gutter);
    padding-left: var(--hero-folder-gutter);
  }

  .category-article-page .navbar-new .brand-new {
    width: var(--hero-tab-width);
    height: var(--hero-tab-height);
    margin-top: calc(var(--hero-tab-top) - var(--hero-nav-top));
    margin-left: var(--hero-tab-offset);
    transform: translate3d(
      0,
      calc(-1 * (var(--hero-tab-top) - var(--hero-nav-top) + 0.25rem)),
      0
    );
  }

  .category-article-page .navbar-new .brand-new-inner {
    width: 11.4rem;
    height: auto;
    aspect-ratio: 8 / 1;
  }

  .category-article-page .nav-brand-logo,
  .category-article-page .footer-brand-logo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .category-article-page .footer-link-logo {
    width: 10rem;
    height: auto;
    aspect-ratio: 8 / 1;
  }

  .category-article-page .nav-link-underline {
    width: 0;
    transition: width 200ms ease;
  }

  .category-article-page .nav-link-new:hover .nav-link-underline,
  .category-article-page .nav-link-new:focus-visible .nav-link-underline {
    width: 100%;
  }

  .category-article-main {
    display: block;
  }

  .category-article-hero,
  .category-article-decisions {
    padding: clamp(8rem, 11vw, 10rem) 1.5rem clamp(5rem, 7vw, 7rem);
    background: var(--article-lavender);
  }

  .category-article-decisions {
    padding-top: clamp(5rem, 7vw, 7rem);
  }

  .category-article-card {
    width: min(100%, 45.375rem);
    margin: 0 auto;
    padding: clamp(2.5rem, 4vw, 3.5rem);
    border-radius: 0.625rem;
    background: var(--article-paper);
  }

  .category-article-header h1,
  .category-decisions-headlines h2 {
    margin: 0;
    font-family: Fraunces, Arial, sans-serif;
    font-size: clamp(2.5rem, 3.2vw, 3rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.025em;
    font-synthesis: none;
  }

  .category-article-header h1 > span,
  .category-decisions-headlines h2 > span {
    display: block;
  }

  .category-article-heading-break {
    margin-top: 2.75rem;
  }

  .category-article-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2rem;
    color: #625f5a;
    font-family: Dmsans, Impact, sans-serif;
    font-size: 0.875rem;
    line-height: 1.25;
  }

  .category-article-reading-meta,
  .category-article-author,
  .category-article-listen {
    display: flex;
    align-items: center;
  }

  .category-article-reading-meta {
    gap: 0.75rem;
  }

  .category-article-author {
    gap: 0.75rem;
    color: var(--article-ink);
  }

  .category-article-author-portrait {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
  }

  .category-article-author-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .category-article-listen {
    gap: 0.375rem;
    min-height: 2rem;
    padding: 0.375rem 0.6875rem;
    border: 1px solid rgb(34 34 34 / 14%);
    border-radius: 999px;
    color: var(--article-ink);
    background: var(--article-canvas);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
  }

  .category-article-listen:hover,
  .category-article-listen[aria-pressed='true'] {
    background: #f4f2ef;
  }

  .category-article-listen svg {
    width: 0.875rem;
    height: 0.875rem;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .category-article-rule {
    height: 1px;
    margin-top: 2rem;
    background: var(--article-hairline);
  }

  .category-article-copy {
    margin-top: 2rem;
  }

  .category-article-copy p,
  .category-article-four-cs p,
  .category-decisions-list {
    font-family: Dmsans, Impact, sans-serif;
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.45;
  }

  .category-article-copy p {
    margin: 0;
  }

  .category-article-copy p + p {
    margin-top: 1.5rem;
  }

  .category-article-copy h2 {
    margin: 2.75rem 0 0;
    font-family: Dmsans, Impact, sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .category-article-four-cs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.5rem;
    margin-top: 1.5rem;
  }

  .category-article-four-cs section {
    min-height: 10rem;
    padding: 1.5rem 0 2rem;
    border-top: 1px solid var(--article-hairline);
  }

  .category-article-four-cs h3 {
    margin: 0;
    font-family: Fraunces, Arial, sans-serif;
    font-size: 2.25rem;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -1.41px;
    font-synthesis: none;
  }

  .category-article-four-cs p {
    margin: 0.875rem 0 0;
  }

  .category-article-quote {
    display: grid;
    place-items: center;
    min-height: clamp(36rem, 72vh, 46rem);
    padding: clamp(6rem, 10vh, 9rem) 2rem;
    color: #fff;
    background: var(--article-deep-ink);
  }

  .category-article-quote figure {
    width: min(100%, 34rem);
    margin: 0;
  }

  .category-article-quote blockquote {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .category-article-quote blockquote p {
    margin: 0;
    font-family: Dmsans, Impact, sans-serif;
    font-size: clamp(1.75rem, 2.2vw, 2.25rem);
    font-weight: 400;
    line-height: 1.13;
    letter-spacing: -0.025em;
  }

  .category-article-quote figcaption {
    margin-top: 4rem;
    color: var(--article-canvas);
    font-family: Dmsans, Impact, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .category-decisions-headlines h2 + h2 {
    margin-top: 2.75rem;
  }

  .category-decisions-list {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .category-decisions-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
    border-top: 1px solid var(--article-hairline);
  }

  .category-decisions-list li > span:last-child {
    flex: 0 0 auto;
    padding: 0.3125rem 0.625rem;
    border: 1px solid var(--article-hairline);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
  }

  @media (min-width: 992px) {
    .category-article-page .navbar-new .navigation-new {
      transform: translate3d(var(--nav-away-inline-shift), 0, 0);
    }
  }

  @media (max-width: 991px) {
    .category-article-page .navigation-new.w--open {
      position: absolute;
      top: 100%;
      left: 0;
      display: block !important;
      width: 100vw;
    }

    .category-article-page .menu-button-new.w--open .burger-line._1 {
      transform: translate3d(0, 0.6875rem, 0) rotate(-45deg) !important;
    }

    .category-article-page .menu-button-new.w--open .burger-line._2 {
      width: 0 !important;
      height: 1px !important;
    }

    .category-article-page .menu-button-new.w--open .burger-line._3 {
      transform: translate3d(0, -0.6875rem, 0) rotate(45deg) !important;
    }
  }

  @media (max-width: 767px) {
    .category-article-hero,
    .category-article-decisions {
      padding: 7rem 1rem 3rem;
    }

    .category-article-decisions {
      padding-top: 3rem;
    }

    .category-article-card {
      padding: 2rem;
    }

    .category-article-header h1,
    .category-decisions-headlines h2 {
      font-size: 2.25rem;
    }

    .category-article-header h1 > span,
    .category-decisions-headlines h2 > span {
      display: inline;
    }

    .category-article-heading-break {
      display: block !important;
      margin-top: 2rem;
    }

    .category-article-meta {
      align-items: flex-start;
      font-size: 0.8125rem;
    }

    .category-article-author {
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
    }

    .category-article-author-portrait {
      width: 36px;
      height: 36px;
    }

    .category-article-copy p,
    .category-article-four-cs p,
    .category-decisions-list {
      font-size: 1rem;
    }

    .category-article-four-cs {
      grid-template-columns: 1fr;
    }

    .category-article-four-cs section {
      min-height: 0;
    }

    .category-article-quote {
      min-height: 34rem;
      padding: 6rem 1.5rem;
    }

    .category-article-quote blockquote p {
      font-size: 1.75rem;
    }

    .category-article-quote figcaption {
      margin-top: 3rem;
    }
  }

  @media (max-width: 479px) {
    .category-article-page .navbar-new .brand-new {
      width: 60%;
      height: 11vw;
      margin-left: -1.5rem;
    }

    .category-article-page .navbar-new .brand-new-inner {
      width: 62%;
      height: 7vw;
    }

    .category-article-card {
      padding: 1.5rem;
    }

    .category-article-header h1,
    .category-decisions-headlines h2 {
      font-size: 2rem;
    }

    .category-article-meta {
      gap: 0.75rem;
    }

    .category-decisions-list li {
      font-size: 0.9375rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .category-article-page .burger-line,
    .category-article-page .navigation-new,
    .category-article-page .nav-link-underline {
      transition: none !important;
    }
  }
</style>
