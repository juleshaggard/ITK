---
import sourceBody from '../content/source-body.html?raw';
import { applySiteCopy } from '../content/site-copy.mjs';
import '../styles/directional-navigation.css';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const homeUrl = base;
const contactUrl = `${base}contact-us/`;
const copiedBody = applySiteCopy(sourceBody);

const navStartMarker = '<div data-animation="default" class="navbar-new w-nav"';
const navStart = copiedBody.indexOf(navStartMarker);
const navEnd = copiedBody.indexOf('<div class="page-wrapper">', navStart);
const faqStart = copiedBody.indexOf('<section id="faqs"');
const footerStart = copiedBody.indexOf('<section class="section footer-new">', faqStart);
const pageWrapperEnd = copiedBody.lastIndexOf('</div>');

if (navStart < 0 || navEnd < 0) {
  throw new Error('Unable to extract the shared homepage navigation.');
}

if (faqStart < 0 || footerStart < 0 || pageWrapperEnd < 0) {
  throw new Error('Unable to extract the shared homepage FAQ and footer.');
}

const navigationLogoPattern =
  /(<a[^>]*class="brand-new-inner w-inline-block"[^>]*>)<svg[\s\S]*?<\/svg>(<\/a>)/;
const footerLogoPattern =
  /(<a[^>]*class="footer-link-logo w-inline-block"[^>]*>)<svg[\s\S]*?<\/svg>(<\/a>)/;
const navigationLogo = `<img src="${base}assets/itk-logo.svg" alt="" class="contain-image nav-brand-logo" width="160" height="20" />`;
const footerLogo = `<img src="${base}assets/itk-logo.svg" alt="" class="contain-image footer-brand-logo" width="160" height="20" style="display:block;width:100%;height:auto;aspect-ratio:8 / 1" />`;

let navigation = copiedBody.slice(navStart, navEnd);
const sharedGlobalEmbeds = copiedBody.slice(0, navStart);
navigation = navigation
  .replace('class="navbar-new w-nav"', 'class="navbar-new is-away-from-hero w-nav"')
  .replace(navigationLogoPattern, `$1${navigationLogo}$2`)
  .replace('href="./" class="brand-new-inner', `href="${homeUrl}" class="brand-new-inner`)
  .replace('href="#" class="nav-link-new', `href="${homeUrl}#how-it-works" class="nav-link-new`)
  .replace('href="#clients" class="nav-link-new', `href="${homeUrl}#clients" class="nav-link-new`)
  .replace('href="#faqs" class="nav-link-new', 'href="#faqs" aria-current="location" class="nav-link-new')
  .replace('href="https://in-the-kitchen.webflow.io/contact-us"', `href="${contactUrl}"`);

const faq = copiedBody.slice(faqStart, footerStart);
const rawFooter = copiedBody
  .slice(footerStart, pageWrapperEnd)
  .replace('href="./" class="footer-link-logo', `href="${homeUrl}" class="footer-link-logo`);

if (!footerLogoPattern.test(rawFooter)) {
  throw new Error('Unable to locate the shared footer logo.');
}

const footer = rawFooter.replace(footerLogoPattern, `$1${footerLogo}$2`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Contact In The Kitchen to discuss positioning for your B2B technology company."
    />
    <title>Contact us | In The Kitchen</title>
    <link rel="stylesheet" href={`${base}styles/webflow.css`} />
    <link rel="icon" href={`${base}assets/favicon-small.png`} />
  </head>
  <body class="body-new contact-page">
    <Fragment set:html={sharedGlobalEmbeds} />
    <div class="page-wrapper">
      <Fragment set:html={navigation} />

      <main class="contact-main">
        <section class="section contact-hero" aria-labelledby="contact-heading">
          <div class="contact-hero-container">
            <div class="contact-folder" style={`--contact-tab-mask: url('${base}assets/yellow-tab.svg')`}>
              <h1 id="contact-heading">Contact us</h1>
              <p>Send an email to jon@inthekitchen.is</p>
              <a href="https://calendly.com/jonitkin/new-meeting" target="_blank" rel="noreferrer">
                Book a call
              </a>
            </div>
          </div>
        </section>

        <Fragment set:html={faq} />
      </main>

      <Fragment set:html={footer} />
    </div>

    <script is:inline>
      (() => {
        const menuButton = document.querySelector('.menu-button-new');
        const navigation = document.querySelector('.navigation-new');
        const navbar = document.querySelector('.navbar-new');

        if (menuButton && navigation && navbar) {
          menuButton.setAttribute('role', 'button');
          menuButton.setAttribute('tabindex', '0');
          menuButton.setAttribute('aria-label', 'menu');
          menuButton.setAttribute('aria-expanded', 'false');

          const setMenu = (open) => {
            const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
            menuButton.classList.toggle('w--open', open);
            navigation.classList.toggle('w--open', open);
            navigation.style.transition = open ? 'all, transform 400ms' : '';
            navigation.style.transform = open ? 'translateY(0px)' : '';
            document.documentElement.style.overflow = open ? 'hidden' : '';
            document.documentElement.style.boxSizing = open ? 'border-box' : '';
            document.documentElement.style.paddingRight = open ? `${scrollbarWidth}px` : '';
            menuButton.setAttribute('aria-expanded', String(open));
          };

          const toggleMenu = () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true');

          menuButton.addEventListener('click', toggleMenu);
          menuButton.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              toggleMenu();
            }
          });

          navigation.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', () => setMenu(false));
          });

          window.addEventListener('resize', () => {
            if (window.innerWidth > 991) setMenu(false);
          });
        }

        const faqItems = [...document.querySelectorAll('.faq-item')];

        const setFaq = (item, open) => {
          const header = item.querySelector('.faq-header-new');
          const answer = item.querySelector('.faq-answer-wrapper');
          const plus = item.querySelector('.plus-icon-faq');
          if (!header || !answer || !plus) return;

          item.classList.toggle('is-open', open);
          header.setAttribute('aria-expanded', String(open));
          answer.style.height = open ? `${answer.scrollHeight}px` : '0px';
          plus.style.transform = open ? 'rotate(45deg)' : 'rotate(0deg)';
        };

        faqItems.forEach((item, index) => {
          const header = item.querySelector('.faq-header-new');
          const answer = item.querySelector('.faq-answer-wrapper');
          if (!header || !answer) return;

          header.setAttribute('role', 'button');
          header.setAttribute('tabindex', '0');
          header.setAttribute('aria-controls', `contact-faq-answer-${index}`);
          answer.id = `contact-faq-answer-${index}`;

          const toggle = () => setFaq(item, !item.classList.contains('is-open'));
          header.addEventListener('click', toggle);
          header.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              toggle();
            }
          });
        });

        if (faqItems[0]) setFaq(faqItems[0], true);

        const syncOpenFaqs = () => {
          faqItems.forEach((item) => {
            if (item.classList.contains('is-open')) setFaq(item, true);
          });
        };

        document.fonts?.ready.then(syncOpenFaqs);
        window.addEventListener('resize', syncOpenFaqs);

        document.querySelectorAll('.copyright-year').forEach((year) => {
          year.textContent = String(new Date().getFullYear());
        });
      })();
    </script>
    <script>
      import { initDirectionalNavigation } from '../scripts/directional-navigation.js';

      initDirectionalNavigation();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --type-serif-weight-light: 300;
    --hero-folder-gutter: clamp(1rem, 1.8vw, 2rem);
    --hero-tab-width: clamp(14rem, 20.6vw, 22rem);
    --hero-tab-half-width: clamp(7rem, 10.3vw, 11rem);
    --hero-tab-height: clamp(2.94rem, 4.327vw, 4.625rem);
    --hero-tab-top: clamp(1.5rem, 2.75vw, 2.5rem);
    --hero-tab-offset: clamp(0.625rem, 0.85vw, 0.875rem);
    --hero-nav-top: clamp(1.25rem, 1.6vw, 1.5rem);
    --nav-away-inline-shift: calc(
      -1 * (var(--hero-tab-offset) + var(--hero-tab-half-width) - 5.7rem)
    );
  }

  html {
    scroll-behavior: smooth;
  }

  .contact-page {
    background: #fdfcfa;
  }

  .contact-page .page-wrapper {
    background: #fdfcfa;
  }

  .contact-page a:focus-visible,
  .contact-page .faq-header-new:focus-visible,
  .contact-page .menu-button-new:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .contact-page .navbar-new {
    padding-top: var(--hero-nav-top);
  }

  .contact-page .nav-bg-main {
    opacity: 1;
    background: #fdfcfa;
  }

  .contact-page .navbar-new .nav-container-new {
    max-width: none;
    padding-right: var(--hero-folder-gutter);
    padding-left: var(--hero-folder-gutter);
  }

  .contact-page .navbar-new .brand-new {
    width: var(--hero-tab-width);
    height: var(--hero-tab-height);
    margin-top: calc(var(--hero-tab-top) - var(--hero-nav-top));
    margin-left: var(--hero-tab-offset);
    transform: translate3d(
      0,
      calc(-1 * (var(--hero-tab-top) - var(--hero-nav-top) + 0.25rem)),
      0
    );
  }

  .contact-page .navbar-new .brand-new-inner {
    width: 11.4rem;
    height: auto;
    aspect-ratio: 8 / 1;
  }

  .contact-page .navbar-new .nav-brand-logo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (min-width: 992px) {
    .contact-page .navbar-new .navigation-new {
      transform: translate3d(var(--nav-away-inline-shift), 0, 0);
      transition: transform 240ms cubic-bezier(0.77, 0, 0.175, 1);
      will-change: transform;
    }
  }

  .contact-page .footer-link-logo {
    width: 10rem;
    height: auto;
    aspect-ratio: 8 / 1;
  }

  .contact-page .footer-link-logo .footer-brand-logo {
    display: block;
    width: 100%;
    height: auto;
  }

  .contact-page .nav-link-underline {
    width: 0;
    transition: width 200ms ease;
  }

  .contact-page .nav-link-new:hover .nav-link-underline,
  .contact-page .nav-link-new:focus-visible .nav-link-underline {
    width: 100%;
  }

  .contact-main {
    display: block;
  }

  .contact-page .contact-hero {
    min-height: 35.75rem;
    padding: clamp(9.5rem, 11vw, 11rem) 0 clamp(6rem, 8vw, 8rem);
    background: #fdfcfa;
  }

  .contact-hero-container {
    width: 100%;
    max-width: 88rem;
    margin: 0 auto;
    padding: 0 4rem;
  }

  .contact-folder {
    position: relative;
    width: min(100%, 53.75rem);
    margin: 0 auto;
    padding: 3.75rem 5.75rem 3.5rem;
    border-radius: 0.625rem;
    background: #2800e8;
    color: #fff;
  }

  .contact-folder::before {
    content: '';
    position: absolute;
    bottom: calc(100% - 1px);
    left: 1.5rem;
    width: 10.375rem;
    height: 1.875rem;
    background: #2800e8;
    -webkit-mask: var(--contact-tab-mask) center bottom / 100% 100% no-repeat;
    mask: var(--contact-tab-mask) center bottom / 100% 100% no-repeat;
  }

  .contact-folder h1 {
    margin: 0 0 3rem;
    color: #fff;
    font-family: Fraunces, Arial, sans-serif;
    font-size: clamp(4rem, 5vw, 4.5rem);
    font-weight: var(--type-serif-weight-light);
    line-height: 0.9;
    letter-spacing: -0.01em;
    font-synthesis: none;
  }

  .contact-folder p,
  .contact-folder a {
    font-family: Dmsans, Impact, sans-serif;
    font-size: 1.5rem;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .contact-folder p {
    margin: 0 0 2rem;
  }

  .contact-folder a {
    color: inherit;
    text-underline-offset: 0.16em;
  }

  .contact-page .section.faq-section {
    background: #fdfcfa;
    color: #222;
  }

  .contact-page .faq-section h2 {
    font-family: Fraunces, Arial, sans-serif;
    font-size: clamp(48px, 4.85vw, 62px);
    font-weight: 300 !important;
    line-height: clamp(50px, 5vw, 64px);
    letter-spacing: -2px;
    font-synthesis: none;
  }

  .contact-page .faq-section h2 .h2-span {
    font-family: Dmsans, Impact, sans-serif;
    font-size: 0.94em;
    font-weight: 400;
  }

  .contact-page .faq-header-new {
    border-top-color: rgba(34, 34, 34, 0.14);
  }

  .contact-page .faq-list-new {
    border-bottom-color: rgba(34, 34, 34, 0.14);
  }

  .contact-page .faq-answer-wrapper {
    overflow: hidden;
    transition: height 300ms ease;
  }

  .contact-page .plus-icon-faq {
    color: #222;
    transition: transform 300ms ease;
  }

  @media (max-width: 991px) {
    .contact-page .navigation-new.w--open {
      position: absolute;
      top: 100%;
      left: 0;
      display: block !important;
      width: 100vw;
    }

    .contact-page .menu-button-new.w--open .burger-line._1 {
      transform: translate3d(0, 0.6875rem, 0) rotate(-45deg) !important;
    }

    .contact-page .menu-button-new.w--open .burger-line._2 {
      width: 0 !important;
      height: 1px !important;
    }

    .contact-page .menu-button-new.w--open .burger-line._3 {
      transform: translate3d(0, -0.6875rem, 0) rotate(45deg) !important;
    }

    .contact-page .contact-hero {
      min-height: 32rem;
      padding-top: 8.5rem;
    }

    .contact-hero-container {
      padding-right: 3rem;
      padding-left: 3rem;
    }

    .contact-folder {
      padding-right: 3rem;
      padding-left: 3rem;
    }
  }

  @media (max-width: 767px) {
    .contact-hero-container {
      padding-right: 2rem;
      padding-left: 2rem;
    }
  }

  @media (max-width: 479px) {
    .contact-page .navbar-new .brand-new {
      width: 60%;
      height: 11vw;
      margin-left: -1.5rem;
    }

    .contact-page .navbar-new .brand-new-inner {
      width: 62%;
      height: 7vw;
    }

    .contact-page .contact-hero {
      min-height: 25.5rem;
      padding-top: 6.875rem;
      padding-bottom: 4rem;
    }

    .contact-hero-container {
      padding-right: 1.5rem;
      padding-left: 1.5rem;
    }

    .contact-folder {
      padding: 2.5rem 1.75rem 2rem;
    }

    .contact-folder::before {
      left: 0.5rem;
      width: 8.3rem;
      height: 1.5rem;
    }

    .contact-folder h1 {
      max-width: 16rem;
      margin-bottom: 2.25rem;
      font-size: 2.5rem;
      line-height: 0.95;
    }

    .contact-folder p,
    .contact-folder a {
      font-size: 1.125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .contact-page .faq-answer-wrapper,
    .contact-page .plus-icon-faq,
    .contact-page .burger-line,
    .contact-page .navigation-new,
    .contact-page .nav-link-underline {
      transition: none !important;
    }
  }
</style>
