---
import sourceBody from '../content/source-body.html?raw';
import { applySiteCopy } from '../content/site-copy.mjs';
import '../styles/directional-navigation.css';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const copiedBody = applySiteCopy(sourceBody);
const heroTabAssetPattern = 'src="assets/yellow-tab.svg"';

if (!copiedBody.includes(heroTabAssetPattern)) {
  throw new Error('Unable to locate the hero folder tab asset.');
}

const bodyWithHeroTab = copiedBody.replace(
  heroTabAssetPattern,
  `src="${base}assets/hero-yellow-tab.svg"`,
);
const clientSectionPattern = /<section id="clients"[\s\S]*?<\/section><section class="section light-bg">[\s\S]*?<\/section>/;
const clientSection = `<section id="clients" class="section light-bg positioning-clients-section">
  <div class="container positioning-clients-container">
    <h2 class="positioning-clients-heading">
      <span>In The Kitchen is a positioning consultancy</span>
      <span>built to help B2B technology leadership</span>
      <span>teams build, defend, and expand authentic</span>
      <span>category leadership.</span>
    </h2>
    <p class="positioning-clients-intro">Positioning support for founders and executives making the next big bet.</p>
    <div class="best-fit-clients-tags positioning-clients-tags" aria-label="Best-fit client qualities">
      <div class="best-fit-clients-tag"><p class="paragraph-s font-medium">Ready to change</p></div>
      <div class="best-fit-clients-tag"><p class="paragraph-s font-medium">Challenger mindset</p></div>
      <div class="best-fit-clients-tag"><p class="paragraph-s font-medium">Facing hard decisions</p></div>
      <div class="best-fit-clients-tag"><p class="paragraph-s font-medium">High ACV</p></div>
      <div class="best-fit-clients-tag"><p class="paragraph-s font-medium">Scrappy</p></div>
      <div class="best-fit-clients-tag"><p class="paragraph-s font-medium">Sales led</p></div>
      <div class="best-fit-clients-tag"><p class="paragraph-s font-medium">Growth stage</p></div>
      <div class="best-fit-clients-tag"><p class="paragraph-s font-medium">Reaching for greatness</p></div>
    </div>
    <div class="logos-grid positioning-clients-logos" aria-label="Selected clients">
      <img src="assets/meta.svg" loading="lazy" alt="Meta" class="logo-image bigger" />
      <img src="assets/summation.webp" loading="lazy" alt="Summation" class="logo-image bigger" />
      <img src="assets/moneylion.svg" loading="lazy" alt="MoneyLion" class="logo-image bigger" />
      <img src="assets/latent.png" loading="lazy" alt="Latent" class="logo-image bigger" />
      <img src="assets/valence.png" loading="lazy" alt="Valence" class="logo-image bigger" />
      <img src="assets/every.png" loading="lazy" alt="Every" class="logo-image bigger" />
      <img src="assets/thunder.svg" loading="lazy" alt="Pulley" class="logo-image bigger" />
      <img src="assets/pulley.svg" loading="lazy" alt="Thunder" class="logo-image bigger" />
      <img src="assets/genesys.png" loading="lazy" alt="Genesys" class="logo-image bigger" />
      <img src="assets/crewai.png" loading="lazy" alt="CrewAI" class="logo-image bigger" />
      <img src="assets/exclaimer.svg" loading="lazy" alt="Exclaimer" class="logo-image bigger" />
      <img src="assets/redpanda.png" loading="lazy" alt="Redpanda" class="logo-image bigger" />
    </div>
  </div>
</section>`;

const investorSectionPattern = /<section class="section lean-in-section">[\s\S]*?<\/section>/;
const investorSection = `<section id="investors" class="section investor-trust-section">
  <div class="investor-trust-panel">
    <h2 class="investor-trust-heading">Trusted by investors who lean in.</h2>
    <div class="investor-trust-layout">
      <div class="investor-trust-group investor-partnerships-group">
        <h3 class="investor-trust-label">Investor partnerships</h3>
        <div class="investor-partnerships-grid">
          <article class="investor-partnership-card">
            <img src="assets/first-round.svg" loading="eager" alt="First Round" />
            <p>Expert in Residence</p>
          </article>
          <article class="investor-partnership-card">
            <img src="assets/norwest.svg" loading="eager" alt="Norwest" />
            <p>Senior Advisor</p>
          </article>
        </div>
      </div>
      <div class="investor-trust-group investor-portcos-group">
        <h3 class="investor-trust-label">We've worked with portcos of</h3>
        <div class="investor-portcos-grid">
          <div class="investor-portco-card"><img src="assets/gv.svg" loading="eager" alt="GV" /></div>
          <div class="investor-portco-card"><img src="assets/insight-partners.png" loading="eager" alt="Insight Partners" /></div>
          <div class="investor-portco-card"><img src="assets/bessemer.png" loading="eager" alt="Bessemer Venture Partners" /></div>
          <div class="investor-portco-card"><img src="assets/salesforce-ventures.svg" loading="eager" alt="Salesforce Ventures" /></div>
          <div class="investor-portco-card"><img src="assets/y-combinator.svg" loading="eager" alt="Y Combinator" /></div>
          <div class="investor-portco-card"><img src="assets/sequoia.svg" loading="eager" alt="Sequoia" /></div>
        </div>
      </div>
    </div>
  </div>
</section>`;

const positioningStoryPattern =
  /<section class="section reinventing-section">[\s\S]*?<section class="section deciding-section">[\s\S]*?<\/section>/;
const duplicateDecisionProcessPattern =
  /<section class="section home-three-items-section">[\s\S]*?<\/section>/;
const testimonialHeadingPattern =
  /(<section class="section b2b-ceos-section">\s*<div class="container">)\s*<h2[\s\S]*?<\/h2>/;
const founderSectionPattern =
  /<section class="section meet-founder-section">[\s\S]*?<\/section>/;
const closingSectionPattern =
  /<section class="section own-your-strategy-section">[\s\S]*?<\/section>/;
const navigationLogoPattern =
  /(<a[^>]*class="brand-new-inner w-inline-block"[^>]*>)<svg[\s\S]*?<\/svg>(<\/a>)/;
const footerLogoPattern =
  /(<a[^>]*class="footer-link-logo w-inline-block"[^>]*>)<svg[\s\S]*?<\/svg>(<\/a>)/;
const howItWorksLinkPattern =
  /(<a[^>]*href=")#("[^>]*class="nav-link-new w-inline-block"[^>]*><div>How it works<\/div>)/;
const navigationLogo = `<img src="${base}assets/itk-logo.svg" alt="" class="contain-image nav-brand-logo" width="160" height="20" />`;
const footerLogo = `<img src="${base}assets/itk-logo.svg" alt="" class="contain-image footer-brand-logo" width="160" height="20" style="display:block;width:100%;height:auto;aspect-ratio:8 / 1" />`;
const positioningStorySection = `<section id="four-cs" class="section positioning-story-section">
  <div class="positioning-story-stack">
  <article class="four-cs-card positioning-story-card">
    <div class="four-cs-inner">
      <div class="four-cs-headlines">
        <h2>
          <span>You don’t create category</span>
          <span>leadership by being a little bit better.</span>
        </h2>
        <h2>
          <span>You do it by being</span>
          <span>fundamentally different.</span>
        </h2>
      </div>
      <div class="four-cs-meta" aria-label="Article details">
        <div class="four-cs-reading-meta">
          <span>4 min read</span>
          <button class="four-cs-listen" type="button" aria-pressed="false">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 14v-2a8 8 0 0 1 16 0v2" />
              <path d="M4 14h2v5H4a2 2 0 0 1-2-2v-1a2 2 0 0 1 2-2Z" />
              <path d="M20 14h-2v5h2a2 2 0 0 0 2-2v-1a2 2 0 0 0-2-2Z" />
            </svg>
            <span class="four-cs-listen-label">Listen</span>
          </button>
        </div>
        <div class="four-cs-author">
          <span class="four-cs-author-portrait" aria-hidden="true">
            <img src="${base}assets/jon-itkin-byline.png" alt="" width="40" height="40" />
          </span>
          <span>By Jon Itkin</span>
        </div>
      </div>
      <div class="four-cs-divider" aria-hidden="true"></div>
      <div class="four-cs-copy">
        <p>People will tell you positioning is a game of inches. Category leaders disagree. They drive compounding advantages across four dimensions, and product capabilities are only one.</p>
        <p>We use the Four Cs heuristic to deeply understand why you win. Then we channel our learnings into positioning and messaging that hits the market like a pile driver.</p>
        <p class="four-cs-label">The four sources of competitive advantage:</p>
      </div>
      <div class="four-cs-grid">
        <article class="four-cs-item">
          <h3>Capability</h3>
          <p>What your buyers can do (and not do) as a result of your product.</p>
        </article>
        <article class="four-cs-item">
          <h3>Credibility</h3>
          <p>What makes you exceptionally trustworthy.</p>
        </article>
        <article class="four-cs-item">
          <h3>Convenience</h3>
          <p>Why it’s easier to buy from you</p>
        </article>
        <article class="four-cs-item">
          <h3>Cost</h3>
          <p>Why you deliver outstanding value relative to investment.</p>
        </article>
      </div>
    </div>
    <figure id="positioning-quote" class="positioning-quote-panel">
      <blockquote>
        <p>“Jon helped us execute a crucial strategic repositioning and build a message that we fully own. Within weeks of launching, we closed our first enterprise deal and built a deep pipeline. The ideas and language we co-created are pulling the company forward.”</p>
      </blockquote>
      <figcaption>Alex Gallego, CEO, Redpanda</figcaption>
    </figure>
    <section class="positioning-decisions-panel" aria-labelledby="positioning-decisions-heading">
      <div class="positioning-decisions-headlines">
        <h2 id="positioning-decisions-heading">
          <span>Marketing copy doesn’t</span>
          <span>make you a category leader.</span>
        </h2>
        <h2>Decisions do.</h2>
      </div>
      <div class="positioning-decisions-divider" aria-hidden="true"></div>
      <div class="positioning-decisions-copy">
        <p>After more than 45 deep-dive positioning exercises, we’ve learned that the most important factor behind positioning success is the integrity of the decisions beneath it.</p>
        <p>So we developed Decision-Based Positioning: a methodology that treats decisions as a first-class deliverable of the positioning process.</p>
        <p>With us, executives spend time debating crucial decisions, not splitting hairs over headlines. You leave with conviction about the path you’re taking, not just what you will say.</p>
      </div>
      <h3 class="positioning-decisions-label">Decisions to win:</h3>
      <ul class="positioning-decisions-list">
        <li><span>Intentions</span><span class="positioning-decision-count">7 decisions</span></li>
        <li><span>Playing Field</span><span class="positioning-decision-count">4 decisions</span></li>
        <li><span>Market Segment</span><span class="positioning-decision-count">3 decisions</span></li>
        <li><span>Buyer</span><span class="positioning-decision-count">4 decisions</span></li>
        <li><span>Problem</span><span class="positioning-decision-count">3 decisions</span></li>
        <li><span>Alternatives</span><span class="positioning-decision-count">3 decisions</span></li>
        <li><span>Advantages</span><span class="positioning-decision-count">5 decisions</span></li>
        <li><span>How You Win</span><span class="positioning-decision-count">2 decisions</span></li>
      </ul>
    </section>
  </article>
  </div>
</section>`;

const positioningProcessSection = `<section id="how-it-works" class="section positioning-process-section">
  <div class="positioning-process-inner">
    <div class="positioning-process-layout">
      <header class="positioning-process-intro">
        <h2 class="positioning-process-heading">
          <span>In The Kitchen does more</span>
          <span>thinking and deeper</span>
          <span>creative work than you’ve</span>
          <span>been taught to expect</span>
        </h2>
        <p>This isn’t overdressed copywriting. It’s not an over-engineered workshop. It’s a methodical process to gather the right information, have the right conversations, take full ownership of your ideas, and get them in market with full fidelity.</p>
        <p class="positioning-process-outcome">You walk away with a set of positioning decisions your leadership team fully owns, plus the homepage, sales deck, and executive narrative that get them in market</p>
      </header>
      <ol class="positioning-process-timeline" aria-label="The In The Kitchen process">
        <li>
          <div class="positioning-process-step">
            <h3>First we learn</h3>
            <p>The underlying truths that matter about your company, category, and buyers.</p>
          </div>
        </li>
        <li>
          <div class="positioning-process-step">
            <h3>Then we talk</h3>
            <p>Genuine working conversations with the people who hold a stake in positioning.</p>
          </div>
        </li>
        <li>
          <div class="positioning-process-step">
            <h3>Then we craft</h3>
            <p>Simply expressed, unadorned definition of your positioning.</p>
          </div>
        </li>
        <li>
          <div class="positioning-process-step">
            <h3>Then we build</h3>
            <p>Core GTM assets that make positioning shippable.</p>
          </div>
        </li>
        <li>
          <div class="positioning-process-step">
            <h3>Then we scale</h3>
            <p>For select clients, we take on limited brand-level creative work.</p>
          </div>
        </li>
      </ol>
    </div>
  </div>
</section>`;

const founderSection = `<section id="founder" class="section founder-profile-section">
  <div class="founder-profile-inner">
    <div class="founder-profile-intro">
      <figure class="founder-profile-portrait">
        <img src="assets/jon-itkin.avif" loading="lazy" alt="Jon Itkin, founder of In The Kitchen" />
      </figure>
      <div class="founder-profile-bio">
        <h2>Meet the person behind<br />your positioning</h2>
        <p>Jon Itkin cut his teeth as a copywriter, strategist, and product marketing leader for companies from Google and Salesforce to early-stage startups.</p>
        <p>Jon shares ideas on <a href="https://www.linkedin.com/in/jonitkin/" target="_blank" rel="noreferrer">LinkedIn</a>, in his <a href="https://in-the-kitchen.webflow.io/home-new?feedbucketKey=itk-feedback#">newsletter</a>, and in the <a href="https://in-the-kitchen.webflow.io/home-new?feedbucketKey=itk-feedback#">articles section</a> of this site.</p>
      </div>
    </div>
    <div class="founder-profile-details">
      <article class="founder-profile-detail">
        <h3>It costs a minimum of<br />$25,000 to hire In The Kitchen.</h3>
        <div class="founder-profile-rule" aria-hidden="true"></div>
        <p>It takes at least four weeks of deep, meaningful work to partner with us. We are booked anywhere from weeks to quarters ahead. We don’t farm out positioning work. What you see, you get.</p>
      </article>
      <article class="founder-profile-detail">
        <h3 class="founder-profile-investment-heading"><span>This is an investment in</span> <span>changing the trajectory</span> <span>of your business</span></h3>
        <div class="founder-profile-rule" aria-hidden="true"></div>
        <p>Our clients’ competitors would love to read case studies about why they’re losing, so we don’t publish them. But we can tell you what happened after the work. One client tripled their win rate against the entrenched category leader. Another launched a new category and closed six-figure enterprise deals within six weeks. Another got 17 press hits and 10x product signups on launch day.</p>
        <p><a href="https://in-the-kitchen.webflow.io/contact-us">Get on the calendar</a>, and we’ll walk you through the work and the stories behind it.</p>
      </article>
    </div>
  </div>
</section>`;

const closingSection = `<section id="contact" class="section closing-folder-section" style="--closing-folder-tab-mask: url('${base}assets/yellow-tab.svg')">
  <div class="closing-folder-shell">
    <div class="closing-folder-tab" aria-hidden="true"></div>
    <div class="closing-folder-panel">
      <div class="closing-folder-content">
        <h2 class="closing-folder-heading">
          <span>It’s time to take</span>
          <span class="closing-folder-emphasis">a position.</span>
        </h2>
        <a class="closing-folder-cta" href="https://in-the-kitchen.webflow.io/contact-us">
          <span>Get In The Kitchen</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>`;

if (!clientSectionPattern.test(copiedBody)) {
  throw new Error('Unable to locate the client-fit and logo sections.');
}

const clientComposedBody = bodyWithHeroTab.replace(clientSectionPattern, clientSection);

if (!investorSectionPattern.test(clientComposedBody)) {
  throw new Error('Unable to locate the investor partnership section.');
}

const investorComposedBody = clientComposedBody.replace(investorSectionPattern, investorSection);

if (!positioningStoryPattern.test(investorComposedBody)) {
  throw new Error('Unable to locate the positioning story sections.');
}

const positioningStoryComposedBody = investorComposedBody.replace(
  positioningStoryPattern,
  `${positioningStorySection}${positioningProcessSection}`,
);

if (!duplicateDecisionProcessPattern.test(positioningStoryComposedBody)) {
  throw new Error('Unable to locate the duplicate decision and process section.');
}

const streamlinedBody = positioningStoryComposedBody.replace(
  duplicateDecisionProcessPattern,
  '',
);

if (!testimonialHeadingPattern.test(streamlinedBody)) {
  throw new Error('Unable to locate the testimonial grid heading.');
}

const testimonialComposedBody = streamlinedBody.replace(
  testimonialHeadingPattern,
  '$1<h2 id="testimonial-grid-heading" class="b2b-testimonial-heading"><span>B2B CEOs and CMOs</span><span>love In The Kitchen</span></h2>',
);

if (!founderSectionPattern.test(testimonialComposedBody)) {
  throw new Error('Unable to locate the founder section.');
}

const founderComposedBody = testimonialComposedBody.replace(
  founderSectionPattern,
  founderSection,
);

if (!closingSectionPattern.test(founderComposedBody)) {
  throw new Error('Unable to locate the closing call-to-action section.');
}

const closingComposedBody = founderComposedBody.replace(
  closingSectionPattern,
  closingSection,
);

if (!navigationLogoPattern.test(closingComposedBody)) {
  throw new Error('Unable to locate the navigation logo.');
}

const pageWithNavigationLogo = closingComposedBody.replace(
  navigationLogoPattern,
  `$1${navigationLogo}$2`,
);

if (!howItWorksLinkPattern.test(pageWithNavigationLogo)) {
  throw new Error('Unable to locate the How it works navigation link.');
}

const pageBodyWithAnchors = pageWithNavigationLogo.replace(
  howItWorksLinkPattern,
  '$1#how-it-works$2',
);

if (!footerLogoPattern.test(pageBodyWithAnchors)) {
  throw new Error('Unable to locate the footer logo.');
}

const pageWithFooterLogo = pageBodyWithAnchors.replace(
  footerLogoPattern,
  `$1${footerLogo}$2`,
);
const pageBody = pageWithFooterLogo.replaceAll(
  'href="https://in-the-kitchen.webflow.io/contact-us"',
  `href="${base}contact-us/"`,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Only one company will be the leader in your category. Let’s make it you."
    />
    <title>Take the lead position | In The Kitchen</title>
    <link rel="stylesheet" href={`${base}styles/webflow.css`} />
    <link rel="icon" href={`${base}assets/favicon-small.png`} />
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('hero-motion-pending');
      }
    </script>
  </head>
  <body class="body-new">
    <Fragment set:html={pageBody} />

    <script is:inline>
      (() => {
        const menuButton = document.querySelector('.menu-button-new');
        const navigation = document.querySelector('.navigation-new');
        const navbar = document.querySelector('.navbar-new');

        if (menuButton && navigation && navbar) {
          menuButton.setAttribute('role', 'button');
          menuButton.setAttribute('tabindex', '0');
          menuButton.setAttribute('aria-label', 'menu');
          menuButton.setAttribute('aria-expanded', 'false');

          const setMenu = (open) => {
            const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
            menuButton.classList.toggle('w--open', open);
            navigation.classList.toggle('w--open', open);
            navigation.style.transition = open ? 'all, transform 400ms' : '';
            navigation.style.transform = open ? 'translateY(0px)' : '';
            document.documentElement.style.overflow = open ? 'hidden' : '';
            document.documentElement.style.boxSizing = open ? 'border-box' : '';
            document.documentElement.style.paddingRight = open ? `${scrollbarWidth}px` : '';
            menuButton.setAttribute('aria-expanded', String(open));
          };

          const toggleMenu = () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true');

          menuButton.addEventListener('click', toggleMenu);
          menuButton.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              toggleMenu();
            }
          });

          navigation.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', () => setMenu(false));
          });

          window.addEventListener('resize', () => {
            if (window.innerWidth > 991) setMenu(false);
          });
        }

        const heroSection = document.querySelector('.home-hero-section');

        if (navbar && heroSection) {
          let heroObserver;
          let resizeFrame;

          const observeHero = () => {
            heroObserver?.disconnect();
            const navHeight = Math.round(navbar.getBoundingClientRect().height);

            heroObserver = new IntersectionObserver(
              ([entry]) => {
                navbar.classList.toggle('is-away-from-hero', !entry.isIntersecting);
              },
              {
                rootMargin: `-${navHeight}px 0px 0px 0px`,
                threshold: 0,
              },
            );

            heroObserver.observe(heroSection);
          };

          observeHero();
          window.addEventListener('resize', () => {
            cancelAnimationFrame(resizeFrame);
            resizeFrame = requestAnimationFrame(observeHero);
          });
        }

        const faqItems = [...document.querySelectorAll('.faq-item')];

        const setFaq = (item, open) => {
          const header = item.querySelector('.faq-header-new');
          const answer = item.querySelector('.faq-answer-wrapper');
          const plus = item.querySelector('.plus-icon-faq');
          if (!header || !answer || !plus) return;

          item.classList.toggle('is-open', open);
          header.setAttribute('aria-expanded', String(open));
          answer.style.height = open ? `${answer.scrollHeight}px` : '0px';
          plus.style.transform = open ? 'rotate(45deg)' : 'rotate(0deg)';
        };

        faqItems.forEach((item, index) => {
          const header = item.querySelector('.faq-header-new');
          const answer = item.querySelector('.faq-answer-wrapper');
          if (!header || !answer) return;

          header.setAttribute('role', 'button');
          header.setAttribute('tabindex', '0');
          header.setAttribute('aria-controls', `faq-answer-${index}`);
          answer.id = `faq-answer-${index}`;

          const toggle = () => setFaq(item, !item.classList.contains('is-open'));
          header.addEventListener('click', toggle);
          header.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              toggle();
            }
          });
        });

        if (faqItems[0]) {
          setFaq(faqItems[0], true);
        }

        const syncOpenFaqs = () => {
          faqItems.forEach((item) => {
            if (item.classList.contains('is-open')) setFaq(item, true);
          });
        };

        document.fonts?.ready.then(syncOpenFaqs);
        window.addEventListener('resize', syncOpenFaqs);

        document.querySelectorAll('.copyright-year').forEach((year) => {
          year.textContent = String(new Date().getFullYear());
        });

        const listenButton = document.querySelector('.four-cs-listen');

        if (listenButton && 'speechSynthesis' in window && 'SpeechSynthesisUtterance' in window) {
          const listenLabel = listenButton.querySelector('.four-cs-listen-label');
          const storyCard = listenButton.closest('.positioning-story-card');
          let activeUtterance = null;

          const resetListenButton = () => {
            activeUtterance = null;
            listenButton.setAttribute('aria-pressed', 'false');
            if (listenLabel) listenLabel.textContent = 'Listen';
          };

          listenButton.addEventListener('click', () => {
            if (activeUtterance) {
              window.speechSynthesis.cancel();
              resetListenButton();
              return;
            }

            const storyText = storyCard
              ? [...storyCard.querySelectorAll(
                  '.four-cs-headlines h2, .four-cs-copy p, .four-cs-item h3, .four-cs-item p, .positioning-quote-panel blockquote p, .positioning-quote-panel figcaption, .positioning-decisions-headlines h2, .positioning-decisions-copy p, .positioning-decisions-label, .positioning-decisions-list li',
                )]
                  .map((element) => element.textContent?.trim())
                  .filter(Boolean)
                  .join('. ')
              : '';

            if (!storyText) return;

            activeUtterance = new window.SpeechSynthesisUtterance(storyText);
            activeUtterance.rate = 0.95;
            activeUtterance.onend = resetListenButton;
            activeUtterance.onerror = resetListenButton;
            listenButton.setAttribute('aria-pressed', 'true');
            if (listenLabel) listenLabel.textContent = 'Stop';
            window.speechSynthesis.speak(activeUtterance);
          });

          window.addEventListener('pagehide', () => {
            if (activeUtterance) window.speechSynthesis.cancel();
          });
        } else if (listenButton) {
          listenButton.hidden = true;
        }

        const testimonialSection = document.querySelector('.b2b-ceos-section');

        if (testimonialSection) {
          const heading = testimonialSection.querySelector('h2');
          const sourceCards = [...testimonialSection.querySelectorAll('.b2b-card-home')];
          const visibleSlots = sourceCards.slice(0, 8);
          const testimonials = sourceCards
            .map((card) => {
              const quote = card.querySelector('p');
              const attribution = card.querySelector('h3');

              return quote && attribution
                ? {
                    quote: quote.textContent?.trim() ?? '',
                    attribution: attribution.textContent?.trim() ?? '',
                  }
                : null;
            })
            .filter(Boolean);

          if (heading) {
            heading.id = 'testimonial-grid-heading';
            heading.className = 'b2b-testimonial-heading';
            heading.innerHTML =
              '<span>B2B CEOs and CMOs</span><span>love In The Kitchen</span>';
            testimonialSection.setAttribute('aria-labelledby', heading.id);
            testimonialSection.setAttribute('tabindex', '0');
          }

          if (visibleSlots.length === 8 && testimonials.length > visibleSlots.length) {
            sourceCards.slice(8).forEach((card) => {
              card.hidden = true;
            });

            visibleSlots.forEach((card, index) => {
              card.dataset.testimonialSlot = String(index);
              card.setAttribute('aria-live', 'off');
            });

            let slotIndex = 0;
            let nextTestimonialIndex = visibleSlots.length;
            let rotationTimer = 0;
            let transitionTimer = 0;
            const rotationInterval = 2200;
            let isVisible = false;
            let isPointerPaused = false;
            let isKeyboardPaused = false;
            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

            const stopRotation = () => {
              window.clearInterval(rotationTimer);
              rotationTimer = 0;
            };

            const rotateTestimonial = () => {
              const card = visibleSlots[slotIndex];
              const quote = card?.querySelector('p');
              const attribution = card?.querySelector('h3');
              const testimonial = testimonials[nextTestimonialIndex];
              if (!card || !quote || !attribution || !testimonial) return;

              card.classList.add('is-changing');
              window.clearTimeout(transitionTimer);
              transitionTimer = window.setTimeout(() => {
                quote.textContent = testimonial.quote;
                attribution.textContent = testimonial.attribution;
                requestAnimationFrame(() => card.classList.remove('is-changing'));
              }, 220);

              slotIndex = (slotIndex + 1) % visibleSlots.length;
              nextTestimonialIndex = (nextTestimonialIndex + 1) % testimonials.length;
            };

            const startRotation = () => {
              if (
                rotationTimer ||
                reducedMotion.matches ||
                !isVisible ||
                isPointerPaused ||
                isKeyboardPaused ||
                document.hidden
              ) {
                return;
              }

              rotationTimer = window.setInterval(rotateTestimonial, rotationInterval);
            };

            const syncRotation = () => {
              stopRotation();
              startRotation();
            };

            testimonialSection.addEventListener('pointerenter', () => {
              isPointerPaused = true;
              stopRotation();
            });

            testimonialSection.addEventListener('pointerleave', () => {
              isPointerPaused = false;
              startRotation();
            });

            testimonialSection.addEventListener('focusin', () => {
              isKeyboardPaused = true;
              stopRotation();
            });

            testimonialSection.addEventListener('focusout', () => {
              isKeyboardPaused = false;
              startRotation();
            });

            document.addEventListener('visibilitychange', syncRotation);
            reducedMotion.addEventListener?.('change', syncRotation);

            if ('IntersectionObserver' in window) {
              const testimonialObserver = new IntersectionObserver(
                ([entry]) => {
                  isVisible = entry.isIntersecting;
                  syncRotation();
                },
                { threshold: 0.12 },
              );

              testimonialObserver.observe(testimonialSection);
            } else {
              isVisible = true;
              startRotation();
            }
          }
        }
      })();
    </script>
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { initDirectionalNavigation } from '../scripts/directional-navigation.js';

      gsap.registerPlugin(ScrollTrigger);
      initDirectionalNavigation();

      const heroHeadline = document.querySelector('.home-hero-section .h1-home-hero');

      if (heroHeadline && heroHeadline.dataset.heroMotion !== 'ready') {
        heroHeadline.dataset.heroMotion = 'ready';
        const heroLead = heroHeadline.querySelector('.home-hero-lead');
        const heroLeadLetters = [...heroHeadline.querySelectorAll('.home-hero-lead-letter')];
        const heroPosition = heroHeadline.querySelector('.home-hero-position');
        const heroMotion = gsap.matchMedia();

        const clearHeroHeadlineMotion = (targets = [...heroLeadLetters, heroPosition]) => {
          const activeTargets = Array.isArray(targets) ? targets.filter(Boolean) : targets;

          if (Array.isArray(activeTargets) ? activeTargets.length : activeTargets) {
            gsap.set(activeTargets, {
              clearProps: 'opacity,transform,visibility',
            });
          }
          heroHeadline.classList.remove('is-animating');
          document.documentElement.classList.remove('hero-motion-pending');
        };

        const initHeroHeadlineMotion = () => {
          heroMotion.add(
            {
              desktop: '(min-width: 768px)',
              mobile: '(max-width: 767px)',
              reduceMotion: '(prefers-reduced-motion: reduce)',
            },
            ({ conditions }) => {
              if (
                !heroLead ||
                !heroPosition ||
                heroLeadLetters.length !== 4 ||
                conditions?.reduceMotion
              ) {
                clearHeroHeadlineMotion([...heroLeadLetters, heroPosition, heroHeadline]);
                return;
              }

              heroHeadline.classList.add('is-animating');

              if (conditions?.mobile) {
                gsap.set(heroHeadline, { autoAlpha: 0, y: 16 });
                document.documentElement.classList.remove('hero-motion-pending');

                const mobileTimeline = gsap.timeline({
                  defaults: { ease: 'expo.out' },
                  onComplete: () => clearHeroHeadlineMotion([heroHeadline]),
                });

                mobileTimeline.to(heroHeadline, {
                  autoAlpha: 1,
                  y: 0,
                  duration: 0.4,
                });

                return () => {
                  mobileTimeline.kill();
                  clearHeroHeadlineMotion([heroHeadline]);
                };
              }

              const compactPositionX = heroLead.offsetLeft - heroPosition.offsetLeft;

              gsap.set(heroLeadLetters, { autoAlpha: 0 });
              gsap.set(heroPosition, { x: compactPositionX });
              document.documentElement.classList.remove('hero-motion-pending');

              const desktopTween = gsap.to([heroPosition, ...heroLeadLetters], {
                x: 0,
                autoAlpha: 1,
                duration: 0.32,
                overwrite: 'auto',
                ease: 'expo.out',
                onComplete: () => clearHeroHeadlineMotion(),
              });

              return () => {
                desktopTween.kill();
                clearHeroHeadlineMotion();
              };
            },
            heroHeadline,
          );
        };

        requestAnimationFrame(initHeroHeadlineMotion);
        window.addEventListener('pagehide', () => heroMotion.revert(), { once: true });
      }

      const founderPortrait = document.querySelector('.founder-profile-portrait');
      const founderPortraitImage = founderPortrait?.querySelector('img');

      if (founderPortrait && founderPortraitImage) {
        const founderHoverMotion = gsap.matchMedia();

        founderHoverMotion.add(
          '(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
          () => {
            let portraitBounds;
            const rotateXTo = gsap.quickTo(founderPortrait, 'rotationX', {
              duration: 0.45,
              ease: 'expo.out',
            });
            const rotateYTo = gsap.quickTo(founderPortrait, 'rotationY', {
              duration: 0.45,
              ease: 'expo.out',
            });
            const portraitScaleXTo = gsap.quickTo(founderPortrait, 'scaleX', {
              duration: 0.36,
              ease: 'expo.out',
            });
            const portraitScaleYTo = gsap.quickTo(founderPortrait, 'scaleY', {
              duration: 0.36,
              ease: 'expo.out',
            });
            const imageXTo = gsap.quickTo(founderPortraitImage, 'x', {
              duration: 0.45,
              ease: 'expo.out',
            });
            const imageYTo = gsap.quickTo(founderPortraitImage, 'y', {
              duration: 0.45,
              ease: 'expo.out',
            });
            const imageScaleXTo = gsap.quickTo(founderPortraitImage, 'scaleX', {
              duration: 0.36,
              ease: 'expo.out',
            });
            const imageScaleYTo = gsap.quickTo(founderPortraitImage, 'scaleY', {
              duration: 0.36,
              ease: 'expo.out',
            });

            gsap.set(founderPortrait, {
              transformPerspective: 900,
              transformOrigin: '50% 50%',
              willChange: 'transform',
            });
            gsap.set(founderPortraitImage, {
              transformOrigin: '50% 50%',
              willChange: 'transform',
            });

            const resetPortrait = () => {
              rotateXTo(0);
              rotateYTo(0);
              portraitScaleXTo(1);
              portraitScaleYTo(1);
              imageXTo(0);
              imageYTo(0);
              imageScaleXTo(1);
              imageScaleYTo(1);
            };

            const handlePointerEnter = () => {
              portraitBounds = founderPortrait.getBoundingClientRect();
              portraitScaleXTo(1.008);
              portraitScaleYTo(1.008);
              imageScaleXTo(1.022);
              imageScaleYTo(1.022);
            };

            const handlePointerMove = ({ clientX, clientY }) => {
              if (!portraitBounds) {
                portraitBounds = founderPortrait.getBoundingClientRect();
              }

              const normalizedX = Math.max(
                -0.5,
                Math.min(0.5, (clientX - portraitBounds.left) / portraitBounds.width - 0.5),
              );
              const normalizedY = Math.max(
                -0.5,
                Math.min(0.5, (clientY - portraitBounds.top) / portraitBounds.height - 0.5),
              );

              rotateXTo(normalizedY * -4);
              rotateYTo(normalizedX * 4);
              imageXTo(normalizedX * -5);
              imageYTo(normalizedY * -4);
            };

            const handlePointerLeave = () => {
              portraitBounds = undefined;
              resetPortrait();
            };

            founderPortrait.addEventListener('pointerenter', handlePointerEnter);
            founderPortrait.addEventListener('pointermove', handlePointerMove);
            founderPortrait.addEventListener('pointerleave', handlePointerLeave);

            return () => {
              founderPortrait.removeEventListener('pointerenter', handlePointerEnter);
              founderPortrait.removeEventListener('pointermove', handlePointerMove);
              founderPortrait.removeEventListener('pointerleave', handlePointerLeave);
              gsap.killTweensOf([founderPortrait, founderPortraitImage]);
              gsap.set([founderPortrait, founderPortraitImage], {
                clearProps: 'transform,transformOrigin,willChange',
              });
            };
          },
        );

        window.addEventListener('pagehide', () => founderHoverMotion.revert(), { once: true });
      }

      const storySection = document.querySelector('.positioning-story-section');
      const quotePanel = document.querySelector('.positioning-quote-panel');

      if (storySection && quotePanel) {
        const storyMotion = gsap.matchMedia();

        storyMotion.add(
          {
            reduceMotion: '(prefers-reduced-motion: reduce)',
            allowMotion: '(prefers-reduced-motion: no-preference)',
          },
          ({ conditions }) => {
            if (conditions?.reduceMotion) {
              const reducedTrigger = ScrollTrigger.create({
                trigger: quotePanel,
                start: 'top 60%',
                onEnter: () => gsap.set(storySection, { backgroundColor: '#afa4e0' }),
                onLeaveBack: () => gsap.set(storySection, { backgroundColor: '#e1dbfc' }),
              });

              return () => reducedTrigger.kill();
            }

            const colorTween = gsap.to(storySection, {
              backgroundColor: '#afa4e0',
              ease: 'none',
              scrollTrigger: {
                id: 'positioning-story-color-shift',
                trigger: quotePanel,
                start: 'top 72%',
                end: 'bottom 42%',
                scrub: 0.65,
              },
            });

            return () => colorTween.scrollTrigger?.kill();
          },
        );

        document.fonts?.ready.then(() => ScrollTrigger.refresh());
      }
    </script>
  </body>
